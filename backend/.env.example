NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://taskflow:taskflow@localhost:5434/taskflow
DB_SSL=false

# Generate independent secrets, for example: openssl rand -hex 32
JWT_ACCESS_SECRET=development-access-secret-change-me-000000000000000000000000
JWT_REFRESH_SECRET=development-refresh-secret-change-me-00000000000000000000000
JWT_ISSUER=taskflow-api
JWT_AUDIENCE=taskflow-web
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

FRONTEND_ORIGINS=http://localhost:5173
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
